cabal-version:      3.0
name:               hinsight
version:            0.1.0.0
synopsis:           Explain GHC type mismatches and typed holes as plain data
description:
  Answers questions about Haskell code that need GHC's own data: why a type
  mismatch happened, and which candidates fit a typed hole. Results are typed
  values and the effects sit behind a record of functions, so the library draws
  nothing and can be used and tested on its own.
license:            MIT
license-file:       LICENSE
author:             Bombay-Boyz
maintainer:         Bombay-Boyz <https://github.com/Bombay-Boyz>
category:           Development, Language
build-type:         Simple
tested-with:        GHC ==9.10.3
extra-doc-files:    README.md
extra-source-files: test/fixtures/*.hs

flag werror
  description: Treat warnings as errors (development and CI; off for consumers, so new GHCs cannot break them)
  default:     False
  manual:      True

common warnings
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
  ghc-options:
    -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wmissing-export-lists -Wunused-imports -Wunused-top-binds
    -Wunused-local-binds -Wunused-matches -Wredundant-constraints
    -Wpartial-fields -Widentities
  if flag(werror)
    ghc-options: -Werror

library
  import:           warnings
  hs-source-dirs:   src
  build-depends:
    , base       >=4.20 && <5
    , directory  >=1.3  && <1.4
    , ghc        ==9.10.3
    , text       >=2.1  && <2.2
  exposed-modules:
    HInsight
    HInsight.Analysis
    HInsight.Cli
    HInsight.Config
    HInsight.Error
    HInsight.Explanation
    HInsight.Ghc.Convert
    HInsight.Ghc.HoleCapture
    HInsight.Ghc.Holes
    HInsight.Ghc.Messages
    HInsight.Ghc.Session
    HInsight.Hole
    HInsight.Report
    HInsight.Source

executable hinsight-demo
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    , base
    , hinsight
    , process  >=1.6 && <1.7
    , text

test-suite hinsight-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    HInsight.CliSpec
    HInsight.ErrorSpec
    HInsight.ExplanationSpec
    HInsight.GhcSessionSpec
    HInsight.HoleSpec
    HInsight.ReportSpec
    HInsight.SourceSpec
    HInsight.Support
  build-depends:
    , base
    , hinsight
    , hspec       >=2.10 && <2.12
    , process     >=1.6  && <1.7
    , QuickCheck  >=2.14 && <2.16
    , text
