cabal-version:      3.0
name:               hinsight-cabal
version:            0.1.0.0
synopsis:           Find the compiler flags of a file's cabal component for hinsight
description:
  Asks cabal, through hie-bios, how the component a file belongs to is
  compiled, and returns that as a hinsight project environment. A separate
  package so that hinsight itself depends on no build tool.
license:            MIT
license-file:       LICENSE
author:             Bombay-Boyz
maintainer:         Bombay-Boyz <https://github.com/Bombay-Boyz>
category:           Development, Language
build-type:         Simple
tested-with:        GHC ==9.10.3

flag werror
  description: Treat warnings as errors (development and CI; off for consumers, so new GHCs cannot break them)
  default:     False
  manual:      True

common warnings
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
  ghc-options:
    -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wmissing-export-lists -Wunused-imports -Wunused-top-binds
    -Wunused-local-binds -Wunused-matches -Wredundant-constraints
    -Wpartial-fields -Widentities
  if flag(werror)
    ghc-options: -Werror

library
  import:           warnings
  ghc-options:      -hiedir=.hie/lib
  hs-source-dirs:   src
  build-depends:
    , base           >=4.20 && <5
    , co-log-core    >=0.3  && <0.4
    , directory      >=1.3  && <1.4
    , filepath       >=1.4  && <1.6
    , hie-bios       >=0.21 && <0.22
    , hinsight       >=0.1  && <0.2
    , text           >=2.1  && <2.2
  exposed-modules:
    HInsight.Cabal
    HInsight.Cabal.Capture
    HInsight.Cabal.Cli
    HInsight.Cabal.Project

executable hinsight-cabal-demo
  import:           warnings
  ghc-options:      -hiedir=.hie/demo
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    , base
    , hinsight
    , hinsight:hinsight-toolchain
    , hinsight-cabal
    , text

test-suite hinsight-cabal-test
  import:           warnings
  ghc-options:      -hiedir=.hie/test
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    HInsight.Cabal.CabalSpec
    HInsight.Cabal.CliSpec
    HInsight.Cabal.CaptureSpec
    HInsight.Cabal.ProjectSpec
  build-depends:
    , base
    , directory
    , filepath
    , hinsight
    , hinsight:hinsight-toolchain
    , hinsight-cabal
    , hspec       >=2.10 && <2.12
    , process     >=1.6  && <1.7
    , QuickCheck  >=2.14 && <2.16
    , temporary
    , text
